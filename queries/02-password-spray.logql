# Password spray: 5+ distinct accounts failing from one IP in 5 minutes.
# This is a detection query; the separate Grafana alert uses a threshold.

count by (source_ip) (
  sum by (source_ip, username) (
    count_over_time(
      {job="identity_detection_lab", scenario="billy_kaplan"}
      | json
      | event_type="login"
      | status="failed"
      [5m]
    ) > bool 0
  )
)